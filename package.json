{
  "name": "@gnolang/amino-ts",
  "version": "0.1.0",
  "description": "Schema-driven Amino binary and JSON encoding/decoding for Tendermint2 and gno.land, byte-compatible with the Go implementation",
  "contributors": [
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnolang/amino-ts.git"
  },
  "keywords": [
    "amino",
    "tm2",
    "tendermint2",
    "gno",
    "gnoland",
    "encoding",
    "serialization"
  ],
  "files": [
    "dist/",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gno": {
      "import": {
        "types": "./dist/gno/index.d.ts",
        "default": "./dist/gno/index.js"
      },
      "require": {
        "types": "./dist/gno/index.d.cts",
        "default": "./dist/gno/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc --noEmit && tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "fixtures": "cd gen && go run . ../testdata",
    "schemas": "cd gen && go run ./schemagen ../src/gno/types.gen.ts && cd .. && eslint --fix src/gno/types.gen.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Alex M.<alex.megalokonomos@tendermint.com>",
  "license": "Apache-2.0",
  "homepage": "https://gno.land/"
}
